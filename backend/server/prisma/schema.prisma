// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output is default to node_modules/.prisma/client, which is compatible with @prisma/client
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  CLUB
  CREATOR
}

model Organization {
  id         String           @id @default(cuid())
  clerkOrgId String           @unique
  name       String
  type       OrganizationType @default(CREATOR)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  instagramAccounts InstagramAccount[]
  viralVideos       ViralVideo[]
  ideas             Idea[]
  plannerItems      PlannerItem[]
  campaigns         Campaign[]
  bookings          Booking[]
  players           Player[]
  savedTrends       SavedTrend[]
  trendAdaptations  TrendAdaptation[]
  monitoredAccounts MonitoredInstagramAccount[]
}

model ViralVideo {
  id          String   @id @default(cuid())
  title       String
  platform    String
  views       Int
  likes       Int
  durationSec Int
  description String
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Idea {
  id          String   @id @default(cuid())
  topic       String
  hook        String
  description String
  whyViral    String
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PlannerItem {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  platform  String
  status    String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaignSlot    CampaignContentSlot?
  trendAdaptation TrendAdaptation?

  @@index([organizationId])
}

enum CampaignObjective {
  TOURNAMENT
  CLINIC
  TEAM_RECRUITMENT
  OTHER
}

enum CampaignSlotPhase {
  PRE
  DURING
  POST
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  objective      CampaignObjective
  eventStartDate DateTime
  eventEndDate   DateTime

  resultValue      Int?
  resultNotes      String?
  resultRecordedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentSlots     CampaignContentSlot[]
  trendAdaptations TrendAdaptation[]

  @@index([organizationId])
}

model CampaignContentSlot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  phase         CampaignSlotPhase
  label         String
  scheduledDate DateTime

  plannerItemId String?      @unique
  plannerItem   PlannerItem? @relation(fields: [plannerItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
}

model InstagramAccount {
  id             String    @id @default(cuid())
  igUserId       String    @unique
  username       String
  pageId         String?
  accessTokenEnc String
  tokenExpiresAt DateTime?
  needsReconnect Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  posts     InstagramPost[]
  snapshots InstagramAccountSnapshot[]
  analyses  InstagramAnalysis[]

  @@index([organizationId])
}

model InstagramPost {
  id        String           @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  igMediaId        String   @unique
  caption          String?
  mediaType        String
  mediaProductType String?
  permalink        String
  mediaUrl         String?
  thumbnailUrl     String?
  postedAt         DateTime

  // latest known metrics (denormalized for fast listing/sorting)
  likeCount         Int  @default(0)
  commentsCount     Int  @default(0)
  reach             Int  @default(0)
  views             Int  @default(0)
  saved             Int  @default(0)
  shares            Int  @default(0)
  totalInteractions Int  @default(0)
  avgWatchTimeMs    Int?

  // derived fields computed at sync time, used by performance analysis
  captionLength Int @default(0)
  hashtagCount  Int @default(0)
  postedHour    Int
  postedDow     Int

  insightsSyncedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  metrics  InstagramPostMetric[]
  analyses InstagramAnalysis[]

  @@index([accountId, postedAt])
}

model InstagramPostMetric {
  id     String        @id @default(cuid())
  postId String
  post   InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  capturedAt        DateTime
  likeCount         Int      @default(0)
  commentsCount     Int      @default(0)
  reach             Int      @default(0)
  views             Int      @default(0)
  saved             Int      @default(0)
  shares            Int      @default(0)
  totalInteractions Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([postId, capturedAt])
}

model InstagramAccountSnapshot {
  id        String           @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  capturedAt         DateTime
  followersCount     Int
  followsCount       Int
  mediaCount         Int
  reachDay           Int?
  profileViewsDay    Int?
  accountsEngagedDay Int?

  createdAt DateTime @default(now())

  @@unique([accountId, capturedAt])
}

model InstagramAnalysis {
  id        String           @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  postId String?
  post   InstagramPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  scope   String // "post" | "account"
  model   String
  payload Json

  createdAt DateTime @default(now())

  @@index([accountId, scope, createdAt])
}

model Booking {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // externalId/courtName/startAt/etc. deliberately mirror Playtomic's real
  // Bookings API shape (booking_id, resource_name, booking_start_date, ...)
  // so swapping the mock generator for a real sync later is a data-source
  // change, not a schema change.
  externalId        String? // Playtomic booking_id once a real club is connected; null for mock rows
  courtName         String
  startAt           DateTime
  endAt             DateTime
  priceCents        Int
  participantsCount Int
  status            String // "CONFIRMED" | "CANCELED"
  source            String   @default("mock") // "mock" | "playtomic" — never mixed silently

  createdAt DateTime @default(now())

  participants BookingParticipant[]

  @@index([organizationId, startAt])
}

model Player {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  email String?

  createdAt DateTime @default(now())

  participations BookingParticipant[]

  @@index([organizationId])
}

model BookingParticipant {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([bookingId, playerId])
  @@index([playerId])
}

// Which platform the content is *from* — kept separate from whether the row
// is demo data (see Trend.isDemo below), the same split Booking makes with
// its own `source` field ("mock" | "playtomic") vs a hypothetical platform
// dimension. Conflating "platform" and "real vs demo" would make it
// impossible to show a realistic multi-platform Discover feed while still
// being honest that no row was actually pulled from TikTok/Instagram yet.
enum TrendSource {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  MANUAL
}

enum TrendStatus {
  NEW
  RISING
  HOT
  STABLE
  DECLINING
  EXPIRED
}

// Global catalogue, deliberately NOT organization-scoped: a viral video is
// the same fact for every org, so it's discovered, scored and AI-analyzed
// once — never duplicated or re-analyzed per club. Isolation lives one level
// down, on SavedTrend/TrendAdaptation. See the Viral Intelligence plan.
model Trend {
  id         String      @id @default(cuid())
  source     TrendSource
  isDemo     Boolean     @default(false) // true for MockTrendProvider rows — never claim these came from the real platform
  externalId String
  url        String

  authorHandle      String
  authorFollowers   Int
  authorMedianViews Int? // baseline for relative performance; null when the source can't provide one

  title        String
  caption      String?
  hashtags     String[]
  durationSec  Int? // null for sources that don't expose it (e.g. Instagram Business Discovery never returns video length)
  thumbnailUrl String?
  publishedAt  DateTime

  views    Int
  likes    Int
  comments Int
  shares   Int
  saves    Int

  // Denormalized scoring output (same call as InstagramPost) — every list
  // query sorts/filters by these, so they must not be recomputed on read.
  viralScore          Int         @default(0)
  scoreBreakdown      Json?
  relativePerformance Float?
  status              TrendStatus @default(NEW)
  scoredAt            DateTime?

  fingerprint String? // normalized title+duration+author, for future cross-source dedup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pattern     TrendPattern?
  savedBy     SavedTrend[]
  adaptations TrendAdaptation[]

  // Re-running discovery must upsert, never duplicate, the same piece of content.
  @@unique([source, externalId])
  @@index([viralScore])
  @@index([fingerprint])
  @@index([isDemo])
}

// AI-extracted creative pattern. 1:1 with Trend and permanently cached — a
// trend is analyzed by the LLM at most once, never re-analyzed on every view.
model TrendPattern {
  id      String @id @default(cuid())
  trendId String @unique
  trend   Trend  @relation(fields: [trendId], references: [id], onDelete: Cascade)

  model   String
  payload Json // full validated CreativePattern (hook, structure, mechanism, editing style...)

  // Denormalized from payload so Discover can filter without touching Json.
  format  String
  topic   String
  emotion String
  ctaType String

  createdAt DateTime @default(now())

  @@index([format])
}

model SavedTrend {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trendId        String
  trend          Trend        @relation(fields: [trendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, trendId])
  @@index([trendId])
}

model TrendAdaptation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trendId        String
  trend          Trend        @relation(fields: [trendId], references: [id], onDelete: Cascade)

  // Set when generated in the context of an active club campaign — lets a
  // recommendation reference "fits your active Summer Tournament campaign".
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  model   String
  payload Json // title, hook, concept, structure, scenes, script, cta, caption, platform, durationSec, rationale
  status  String @default("DRAFT") // "DRAFT" | "PLANNED"

  // The feedback loop's spine: Trend -> Adaptation -> PlannerItem, queryable
  // from day one so PlannerItem -> InstagramPost can close the loop later
  // without a migration.
  plannerItemId String?      @unique
  plannerItem   PlannerItem? @relation(fields: [plannerItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
}

// An org's watchlist of real Instagram accounts to pull viral Reels from via
// Business Discovery. Org-scoped as *input* (each org curates its own list),
// but the Trend rows it produces are global, same as every other source —
// see Trend's own comment for why. Multiple orgs can watch the same
// username; InstagramTrendProvider dedupes to one API call per username.
model MonitoredInstagramAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  username String // Instagram handle, without '@'

  lastSyncedAt  DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())

  @@unique([organizationId, username])
  @@index([organizationId])
}
